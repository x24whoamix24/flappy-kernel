+static void probe_gpcs(int num_sms) {
+  std::vector<int> gpc(kMaxSms, -1);
+  std::vector<int> parent(kMaxSms);
+  for (int i = 0; i < kMaxSms; i++) {
+    parent[i] = i;
+  }
+  unsigned *d_sm = nullptr;
+  cudaMalloc(&d_sm, kMaxSms * sizeof(unsigned));
+  std::vector<unsigned> sm(kMaxSms);
+  cudaFuncSetAttribute(
+      record_sm_kernel, cudaFuncAttributeNonPortableClusterSizeAllowed, 1);
+  bool any = false;
+  for (int cluster : {16, 8}) {
+    for (int grid = cluster; grid <= std::min(num_sms, kMaxSms);
+         grid += cluster) {
+      cudaLaunchConfig_t cfg = {};
+      cfg.gridDim = dim3(grid);
+      cfg.blockDim = dim3(32);
+      cudaLaunchAttribute attr;
+      attr.id = cudaLaunchAttributeClusterDimension;
+      attr.val.clusterDim.x = cluster;
+      attr.val.clusterDim.y = 1;
+      attr.val.clusterDim.z = 1;
+      cfg.attrs = &attr;
+      cfg.numAttrs = 1;
+      if (cudaLaunchKernelEx(&cfg, record_sm_kernel, d_sm) != cudaSuccess ||
+          cudaMemcpy(sm.data(), d_sm, grid * sizeof(unsigned),
+                     cudaMemcpyDeviceToHost) != cudaSuccess) {
+        cudaGetLastError();
+        continue;
+      }
+      any = true;
+      for (int c = 0; c < grid; c += cluster) {
+        for (int k = 1; k < cluster; k++) {
+          parent[find_root(parent, sm[c + k])] = find_root(parent, sm[c]);
+        }
+      }
+    }
+  }
+  cudaFree(d_sm);
+  if (any) {
+    for (int s = 0; s < std::min(num_sms, kMaxSms); s++) {
+      gpc[s] = find_root(parent, s);
+    }
+  }
+  cudaMemcpyToSymbol(mpk_sm_gpc, gpc.data(), kMaxSms * sizeof(int));
+}
