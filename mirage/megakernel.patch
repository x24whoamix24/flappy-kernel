+// Block placement in the fused launch (MPK_COTENANT_FUSED). The hardware
+// decides which SM runs which block, and decode is ~5% slower when MPK's
+// workers share a GPC with its schedulers than when the co-tenants do: the
+// latency-bound schedulers suffer more next to memory-bound workers than next
+// to compute-bound learners. So every launch assigns roles after placement:
+// blocks on SMs in the schedulers' GPCs become co-tenants, the rest workers.
+constexpr int kMaxSms = 256;
+__device__ int mpk_sm_gpc[kMaxSms];        // from probe_gpcs(); -1 if unknown
+__device__ unsigned mpk_block_sm[kMaxSms]; // per worker-kernel block
+__device__ unsigned mpk_sched_sm[kMaxSms]; // per scheduler block
+__device__ unsigned mpk_placed_blocks;     // reset before every launch
+__device__ unsigned mpk_placed_schedulers; // reset before every launch
+// How roles are chosen in this launch, decided once for every block alike:
+// 0 undecided, 1 by the schedulers' GPCs, 2 by block order. Reset before
+// every launch.
+__device__ unsigned mpk_placement;
+
+__device__ __forceinline__ unsigned current_sm() {
+  unsigned sm;
+  asm volatile("mov.u32 %0, %%smid;" : "=r"(sm));
+  return sm;
+}
+
+struct BlockRole {
+  bool cotenant;
+  int index; // co-tenant block or worker id
+};
+
+// Thread 0 of every worker-kernel block, once per launch. All blocks are
+// resident (persistent launch), so they can wait for each other here.
+__device__ __noinline__ BlockRole place_block(RuntimeConfig const &config) {
+  int const num_blocks = gridDim.x;
+  int const num_sched_blocks =
+      config.num_local_schedulers / SCHEDULERS_PER_BLOCK;
+  unsigned volatile *block_sm = mpk_block_sm;
+  unsigned volatile *sched_sm = mpk_sched_sm;
+  block_sm[blockIdx.x] = current_sm();
+  __threadfence();
+  atomicAdd(&mpk_placed_blocks, 1u);
+  while (atomicAdd(&mpk_placed_blocks, 0u) < unsigned(num_blocks)) {
+    __nanosleep(100);
+  }
+  // The schedulers start together with the workers; without them within a
+  // millisecond, keep MPK's default roles. The first block to see either
+  // outcome publishes it, so that every block assigns roles the same way.
+  long long deadline;
+  asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(deadline));
+  deadline += 1000000;
+  unsigned decision;
+  while ((decision = atomicAdd(&mpk_placement, 0u)) == 0u) {
+    long long now;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(now));
+    if (atomicAdd(&mpk_placed_schedulers, 0u) == unsigned(num_sched_blocks)) {
+      atomicCAS(&mpk_placement, 0u, 1u);
+    } else if (now > deadline) {
+      atomicCAS(&mpk_placement, 0u, 2u);
+    } else {
+      __nanosleep(100);
+    }
+  }
+  bool const known = decision == 1u;
+  __threadfence();
+  auto preferred = [&](int b) {
+    int const gpc = known ? mpk_sm_gpc[block_sm[b]] : -1;
+    for (int i = 0; gpc >= 0 && i < num_sched_blocks; i++) {
+      if (mpk_sm_gpc[sched_sm[i]] == gpc) {
+        return true;
+      }
+    }
+    return false;
+  };
+  // Co-tenants: the preferred blocks in block order, topped up (or, without
+  // placement information, entirely made up) by the last other blocks.
+  int num_preferred = 0;
+  for (int b = 0; b < num_blocks; b++) {
+    num_preferred += preferred(b);
+  }
+  int const num_others = num_blocks - num_preferred;
+  int const top_up = MPK_COTENANT_BLOCKS - min(num_preferred, MPK_COTENANT_BLOCKS);
+  int preferred_seen = 0, others_seen = 0, cotenants = 0, workers = 0;
+  for (int b = 0; b < num_blocks; b++) {
+    bool const cotenant = preferred(b)
+                              ? preferred_seen++ < MPK_COTENANT_BLOCKS
+                              : others_seen++ >= num_others - top_up;
+    if (b == int(blockIdx.x)) {
+      return {cotenant, cotenant ? cotenants : workers};
+    }
+    (cotenant ? cotenants : workers)++;
+  }
+  return {false, int(blockIdx.x)};
+}
